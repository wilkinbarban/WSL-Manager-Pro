QMainWindow, QDialog, QWidget {
    background-color: #1b1d21;
    color: #dde2ea;
    font-family: "Segoe UI", "Ubuntu", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QTabWidget::pane {
    border: 1px solid #30353d;
    border-radius: 10px;
    background-color: #20242b;
    margin-top: 4px;
}
QTabBar::tab {
    background-color: #252b34;
    color: #c7d0dc;
    padding: 6px 14px;
    border: 1px solid #333a45;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom: none;
}
QTabBar::tab:selected {
    background-color: #1f242c;
    color: #ffffff;
    border-bottom: 2px solid #36a3ff;
}
QTabBar::tab:hover {
    background-color: #2a313c;
}

QTableWidget {
    background-color: #20242b;
    alternate-background-color: #252a32;
    gridline-color: #2a3038;
    selection-background-color: #1f4f75;
    selection-color: #ffffff;
    border: 1px solid #30353d;
    border-radius: 9px;
}
QTableWidget::item {
    padding: 4px 6px;
}
QHeaderView::section {
    background-color: #2a3039;
    color: #d7dde8;
    padding: 6px;
    border: none;
    border-right: 1px solid #333a44;
    border-bottom: 1px solid #333a44;
    font-weight: 600;
}
QTableWidget QTableCornerButton::section {
    background-color: #2a3039;
    border: none;
    border-right: 1px solid #333a44;
    border-bottom: 1px solid #333a44;
}

QPushButton {
    background-color: #1c6fb2;
    color: #ffffff;
    border: 1px solid #237dc4;
    min-height: 28px;
    padding: 4px 11px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton:hover { background-color: #2282ce; }
QPushButton:pressed { background-color: #195f98; }
QPushButton:disabled {
    background-color: #2f343d;
    border-color: #3b424d;
    color: #7e8793;
}
QPushButton#dangerButton {
    background-color: #8f2b2b;
    border-color: #a43a3a;
}
QPushButton#dangerButton:hover { background-color: #a43838; }
QPushButton#compactButton {
    min-height: 26px;
    padding: 3px 9px;
    border-radius: 6px;
    font-size: 11px;
}
QPushButton#tableActionStart,
QPushButton#tableActionStop {
    min-height: 22px;
    max-height: 22px;
    min-width: 58px;
    max-width: 58px;
    padding: 0;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#tableActionStart {
    background-color: #1d65b7;
    border-color: #2a77cf;
}
QPushButton#tableActionStart:hover { background-color: #2774cc; }
QPushButton#tableActionStart:pressed { background-color: #164d8f; }
QPushButton#tableActionStop {
    background-color: #2a7e43;
    border-color: #349a52;
}
QPushButton#tableActionStop:hover { background-color: #32914e; }
QPushButton#tableActionStop:pressed { background-color: #206337; }

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #2a3038;
    color: #dde2ea;
    border: 1px solid #424a56;
    border-radius: 7px;
    padding: 4px 7px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #3aa1ff;
}

QComboBox {
    background-color: #2a3038;
    color: #dde2ea;
    border: 1px solid #424a56;
    min-height: 28px;
    border-radius: 7px;
    padding: 3px 8px;
}
QComboBox::drop-down { border: none; }
QComboBox QAbstractItemView {
    background-color: #2a3038;
    color: #dde2ea;
    selection-background-color: #1f4f75;
}

QSpinBox {
    background-color: #2a3038;
    color: #dde2ea;
    border: 1px solid #424a56;
    min-height: 28px;
    border-radius: 7px;
    padding: 3px 6px;
}

QProgressBar {
    background-color: #2a3038;
    border: 1px solid #424a56;
    border-radius: 4px;
    text-align: center;
    color: #dde2ea;
}
QProgressBar::chunk {
    background-color: #2e95e8;
    border-radius: 3px;
}

QScrollBar:vertical {
    background-color: #1a1d22;
    width: 10px;
}
QScrollBar::handle:vertical {
    background-color: #4a5361;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background-color: #5a6475; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background-color: #1a1d22;
    height: 10px;
}
QScrollBar::handle:horizontal {
    background-color: #4a5361;
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background-color: #5a6475; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QToolBar {
    background-color: #252b35;
    border: 1px solid #313946;
    border-radius: 8px;
    spacing: 6px;
    padding: 5px 8px;
    margin-bottom: 4px;
}

QStatusBar {
    background-color: #202733;
    color: #ffffff;
    border-top: 1px solid #2f3744;
}

QSplitter::handle {
    background-color: #313946;
}

QGroupBox {
    border: 1px solid #313946;
    border-radius: 10px;
    margin-top: 9px;
    padding-top: 6px;
    color: #cfd6e1;
    background-color: #20242b;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 11px;
    padding: 0 6px;
    color: #f2f5fa;
    font-weight: 600;
}

QFrame#sectionPanel {
    background-color: #20242b;
    border: 1px solid #313946;
    border-radius: 9px;
}
QFrame#formCard {
    background-color: #1f232a;
    border: 1px solid #313946;
    border-radius: 9px;
}
QLabel#sectionTitle {
    color: #f2f5fa;
    font-size: 12px;
    font-weight: 600;
}
QLabel[role="muted"] {
    color: #9ea7b5;
}

QLabel { color: #dde2ea; }
QCheckBox { color: #dde2ea; }
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #485160;
    background-color: #2a3038;
    border-radius: 3px;
}
QCheckBox::indicator:checked {
    background-color: #2e95e8;
    border-color: #2e95e8;
}

QMenu {
    background-color: #252b34;
    color: #dde2ea;
    border: 1px solid #313946;
}
QMenu::item:selected { background-color: #1f4f75; }
QMenu::separator {
    height: 1px;
    background: #313946;
    margin: 3px 0;
}

QMessageBox { background-color: #1b1d21; }
QDialogButtonBox { background-color: #1b1d21; }
QDialog { background-color: #1b1d21; }

QListWidget {
    background-color: #20242b;
    border: 1px solid #313946;
    color: #dde2ea;
    alternate-background-color: #252a32;
}
QListWidget::item:selected { background-color: #1f4f75; }
QListWidget::item:hover { background-color: #2b4f6a; }
